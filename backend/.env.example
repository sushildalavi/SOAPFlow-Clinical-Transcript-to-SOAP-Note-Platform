# =============================================================================
# SOAPFlow Backend — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Canonical source of truth: backend/app/core/config.py
# IMPORTANT: Never commit your .env file. It contains sensitive API keys.
# =============================================================================

# ─── AI Provider API Keys ────────────────────────────────────────────────────
# At least one hosted key is recommended for production. Local backends
# (ollama, mlx) and `demo` mode require no keys.

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Groq — free-tier hosted Llama / Mixtral (https://console.groq.com/keys)
GROQ_API_KEY=

# ─── Generation Mode ─────────────────────────────────────────────────────────
# One of: openai | anthropic | groq | ollama | mlx | demo
#
# Auto-promotion: if GENERATION_MODE=demo but a hosted key is set, the server
# upgrades to openai → anthropic → groq (preference order). Local modes
# (ollama, mlx) are never auto-selected — set them explicitly.
GENERATION_MODE=demo

# ─── Hosted Model Selection (optional — defaults shown) ──────────────────────
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-opus-4-6
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_S=120

# ─── Local: Ollama (https://ollama.com) ──────────────────────────────────────
# Run `ollama pull qwen2.5:7b` then `ollama serve` first.
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_S=600

# ─── Local: MLX (Apple Silicon only) ─────────────────────────────────────────
# Set MLX_ADAPTER_PATH to a directory under adapters/ to load a LoRA adapter.
MLX_MODEL=mlx-community/Qwen2.5-3B-Instruct-4bit
MLX_ADAPTER_PATH=
MLX_MAX_TOKENS=2048
MLX_MAX_TRANSCRIPT_CHARS=6000

# ─── Application Settings ────────────────────────────────────────────────────
APP_NAME=SOAPFlow
APP_VERSION=1.0.0
DEBUG=false

# ─── Database ────────────────────────────────────────────────────────────────
# Default is local SQLite. For Postgres use:
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/soapflow
# Leave unset to use the SQLite default at backend/soapflow.db.
# DATABASE_URL=

# ─── CORS Configuration ──────────────────────────────────────────────────────
# Add your production frontend URL here for deployment.
# Example: ALLOWED_ORIGINS=["https://soapflow.yourdomain.com"]
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# ─── Input Validation Limits ─────────────────────────────────────────────────
MAX_TRANSCRIPT_LENGTH=20000
MIN_TRANSCRIPT_LENGTH=50
