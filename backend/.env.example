# =============================================================================
# SOAPFlow Backend — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit your .env file. It contains sensitive API keys.
# =============================================================================

# ─── AI Provider API Keys ────────────────────────────────────────────────────
# At least one is recommended for production. Demo mode works without any keys.

# OpenAI API key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Anthropic API key (get from https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# ─── Generation Mode ─────────────────────────────────────────────────────────
# "openai"    — Use OpenAI GPT-4o (requires OPENAI_API_KEY)
# "anthropic" — Use Anthropic Claude (requires ANTHROPIC_API_KEY)
# "demo"      — Rule-based fallback (always available, no key needed)
#
# Auto-promotion: If mode=demo but keys are present, the server automatically
# upgrades to openai (or anthropic if no OpenAI key configured).
GENERATION_MODE=demo

# ─── Model Selection (optional) ──────────────────────────────────────────────
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-opus-4-6

# ─── Application Settings ────────────────────────────────────────────────────
APP_NAME=SOAPFlow
APP_VERSION=1.0.0
DEBUG=false

# ─── CORS Configuration ──────────────────────────────────────────────────────
# Add your production frontend URL here for deployment
# Example: ALLOWED_ORIGINS=["https://soapflow.yourdomain.com"]
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# ─── Input Validation Limits ─────────────────────────────────────────────────
MAX_TRANSCRIPT_LENGTH=20000
MIN_TRANSCRIPT_LENGTH=50
